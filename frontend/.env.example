# Copy to .env.local for local development.

# Where the Next.js server (server actions, and the /api rewrite) reaches the backend.
BACKEND_URL=http://localhost:3001
# What the browser calls — goes through the /api rewrite above.
NEXT_PUBLIC_API_URL=/api
# The /api rewrite only proxies plain HTTP, not WebSocket upgrades, so live
# tracking connects straight to the backend. Point this at wherever the
# backend is reachable from the browser.
NEXT_PUBLIC_WS_URL=ws://localhost:3001
# Must match the backend's VAPID_PUBLIC_KEY (see backend/.env.example).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Google OAuth client ID for the citizens' "Sign in with Google" button —
# must match the backend's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
