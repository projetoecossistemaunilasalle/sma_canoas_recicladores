NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recicladores?sslmode=disable
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Multiportal / 1gps.com.br vehicle tracking integration. Optional — if
# MULTIPORTAL_USERNAME is unset, the sync job (backend/src/integrations)
# just logs that it's disabled and does nothing.
MULTIPORTAL_BASE_URL=http://apiv1.1gps.com.br
MULTIPORTAL_USERNAME=
MULTIPORTAL_PASSWORD=
MULTIPORTAL_APP_ID=
