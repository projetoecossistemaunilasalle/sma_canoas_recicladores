# Backend
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@db:5432/recicladores?sslmode=disable
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Frontend / Next.js
PORT=3000
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://backend:3001
# The /api rewrite above only proxies plain HTTP — WebSocket upgrades aren't
# proxied by Next, so the public home connects straight to the backend's own
# origin for live tracking. Point this at wherever the backend is actually
# reachable from the browser (in prod: its public URL, not the internal
# `backend:3001` service name above).
NEXT_PUBLIC_WS_URL=ws://localhost:3001
